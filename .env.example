# ---- Frontend (Netlify build, or a local .env for `npm run build`) ----
# Render backend URL. Leave empty for local dev, where one server serves everything.
VITE_BACKEND_URL=

# ---- Backend (Render environment, or your shell for local runs) ----
# Netlify site the phone should open from the QR code. Also the only allowed WebSocket origin.
FRONTEND_URL=
# Optional extra origins, comma separated (overrides the FRONTEND_URL default).
ALLOWED_ORIGINS=
# Render sets PORT and RENDER automatically. TLS=off forces plain HTTP elsewhere.
PORT=
TLS=
# Local dev only: public address for the QR code (e.g. a Tailscale name) and LAN IP override.
PUBLIC_URL=
HOST_IP=
